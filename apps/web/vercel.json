{
  "buildCommand": "vite build",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://api-production-96b3e41c.up.railway.app/v1/:path*"
    },
    {
      "source": "/t/:path*",
      "destination": "https://api-production-96b3e41c.up.railway.app/t/:path*"
    },
    {
      "source": "/u/:path*",
      "destination": "https://api-production-96b3e41c.up.railway.app/u/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
